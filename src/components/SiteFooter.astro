---
/**
 * Site footer chrome for a localized page: the page's single `<footer>`, i.e.
 * its `contentinfo` landmark, wrapped around `SiteFooterContent` for the
 * reader's locale.
 *
 * The text — including MIG-05's "not affiliated with Mitsubishi Motors"
 * notice — lives in `SiteFooterContent.astro`, which `src/pages/404.astro`
 * also uses (once per locale, inside one `<footer>`). Both routes to the
 * footer therefore render the same strings from the same place.
 */
import SiteFooterContent from "./SiteFooterContent.astro";
import { type Locale } from "../i18n/routing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer>
  <SiteFooterContent locale={locale} />
</footer>
