---
/** Site chrome: brand, primary nav, locale switcher. All text via `t()` (I18N-08). */
import LocaleSwitcher from "./LocaleSwitcher.astro";
import { localeHref, type Locale } from "../i18n/routing";
import { t } from "../i18n/ui";

interface Props {
  locale: Locale;
  routePath: string;
}

const { locale, routePath } = Astro.props;
const strings = t(locale);
---

<header>
  <a class="brand" href={localeHref(locale, "/")}>
    <strong>{strings.siteName}</strong>
    <span>{strings.siteTagline}</span>
  </a>
  <nav aria-label={strings.navLabel}>
    <ul>
      <li>
        <a
          href={localeHref(locale, "/")}
          aria-current={routePath === "/" ? "page" : undefined}
          >{strings.navHome}</a
        >
      </li>
    </ul>
  </nav>
  <LocaleSwitcher locale={locale} routePath={routePath} />
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem;
  }

  header nav ul {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .brand {
    display: flex;
    flex-direction: column;
  }
</style>
