---
/**
 * A listing's vehicle readout: the green fit-count line, the standing
 * provisional-matching warning, and every string the per-row markers need
 * (FIT-03).
 *
 * Ships `hidden` and stays hidden until a selection exists — with no truck
 * chosen there is no count to report and no permissive matching to warn about.
 *
 * ## Why this block carries the row markers' text
 *
 * `src/lib/vehicle-listing.ts` builds the "filtered" and "provisional" rows in
 * the browser, on the rows that need them, rather than the page rendering two
 * hidden paragraphs into every card. Server-rendering them cost the glossary
 * about 98 KB — two hidden paragraphs × 154 term cards — and five points of
 * SCF-06 performance budget, to ship markup that only ever appears for a
 * reader who has both JavaScript and a selected vehicle.
 *
 * Runtime-built elements still may not contain a hard-coded English word, so
 * every string they use travels here, once per page, in the page's own locale
 * (I18N-08). `facetLabels` is the `fitmentFacet.*` map for whichever facets
 * the fitment engine can report, derived from `OPTIONAL_SELECTION_FACETS` so a
 * facet added to the engine cannot reach the reader untranslated.
 *
 * refs specs/001-foundation (FIT-03, I18N-08, SCF-06)
 */
import { OPTIONAL_SELECTION_FACETS } from "../lib/fitment";
import { fitmentFacetLabel, t } from "../i18n/ui";
import type { Locale } from "../i18n/routing";

interface Props {
  locale: Locale;
  /**
   * The page fitment table (`buildFitmentTable(...).table`). Emitted once here
   * and indexed by each card's `data-fitment`, so a listing whose entries
   * mostly share one fitment pays for it once instead of per row.
   */
  fitments: readonly unknown[];
}

const { locale, fitments } = Astro.props;
const strings = t(locale);

const facetLabels = Object.fromEntries(
  OPTIONAL_SELECTION_FACETS.map((facet) => [
    facet,
    fitmentFacetLabel(strings, facet),
  ])
);
---

<div
  class="vehicle-summary"
  data-vehicle-summary
  data-fit-template={strings.vehicleFitCountTemplate}
  data-provisional-template={strings.vehicleProvisionalDetailTemplate}
  data-facet-labels={JSON.stringify(facetLabels)}
  data-filtered-tag={strings.vehicleFilteredTag}
  data-does-not-fit={strings.vehicleDoesNotFitLabel}
  data-provisional-label={strings.vehicleProvisionalLabel}
  data-fitments={JSON.stringify(fitments)}
  hidden
>
  <p class="vehicle-summary__fit" data-vehicle-fit aria-live="polite"></p>
  <p class="vehicle-summary__note" data-vehicle-provisional-note hidden>
    {strings.vehicleProvisionalNote}
  </p>
</div>

<style>
  .vehicle-summary {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .vehicle-summary[hidden] {
    display: none;
  }

  .vehicle-summary__fit {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    /* HANDOFF-DESIGN: green is the positive state, and the fit count is one. */
    color: #3e6b4f;
  }

  /* The dashed confidence-caveat panel token, for the standing warning. */
  .vehicle-summary__note {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #55493c;
    background: #efeae0;
    border: 1.5px dashed #a99c88;
    border-radius: 8px;
    padding: 0.625rem 0.875rem;
    max-width: 78ch;
  }

  .vehicle-summary__note[hidden] {
    display: none;
  }
</style>
