  "prose": {
    "en": {
      "title": "brake master cylinder",
      "summary": "The cylinder the pedal acts on, which sends pressure to all four wheels. Costa Rican catalogues list it as the bomba principal de freno and the wheel cylinders as bombas auxiliares."
    },
    "es": {
      "title": "bomba principal de freno",
      "summary": "El cilindro sobre el que actúa el pedal y que manda presión a las cuatro ruedas. Los catálogos ticos la listan así, y a los cilindros de rueda les dicen bombas auxiliares."
    }
