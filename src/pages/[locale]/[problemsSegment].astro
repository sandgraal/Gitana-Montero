---
/**
 * The problems index (PRB-01…PRB-06) — the way into the problem finder.
 *
 * ## Scope: the listing, plus T402's symptom-first navigation
 *
 * This page is every problem, worst triage first, filtered through the
 * vehicle selector — that part shipped with T401 because the selector
 * obligation it carries (dim-not-hide plus a prominent provisional
 * indicator) is a *listing* behaviour, and because a detail page whose
 * breadcrumb pointed at a 404 would be a broken template.
 *
 * T402 adds the two ways PRB-02 promises a reader can arrive at "matching
 * problems" — pick or search a symptom phrase — as a client-side layer on
 * top of that same listing, the same relationship the glossary's search box
 * and system pills have to its term list (`[glossarySegment].astro`):
 *
 * - **Search** (`data-problems-search`): free text matched, substring and
 *   accent/case-insensitive, against each card's title, summary, symptom
 *   bullets and chip text — `src/lib/problems-filter.ts`'s `buildHaystack`.
 * - **Symptom index** (`data-symptom` pills): one pill per *distinct*
 *   symptom phrase across every listed problem, built server-side by
 *   `buildSymptomIndex` from the same `problems` array below (deduped by
 *   normalized text — see that function's docs for why there is no shared
 *   symptom taxonomy to dedupe by id instead). Picking a pill is an exact
 *   match against a card's own symptom set, not a substring search.
 *
 * The two facets AND together and both default to permissive, so the
 * enhancement reproduces the server-rendered listing on load — same
 * contract as every other filtered listing on this site. Progressive
 * enhancement follows the community/glossary pattern exactly: the toolbar
 * is laid out only once `BaseLayout` marks the document `html.js`, so a
 * visitor with no JavaScript sees the full listing and no dead control.
 *
 * ## Ordering is triage, not the alphabet
 *
 * `compareProblems` in `src/lib/problems.ts`: drivability first, then severity,
 * then the reader's own collation. A list of problems is read by someone
 * deciding whether to drive; "tow only" belongs above "safety-critical but
 * drives normally", and both belong above a rattle.
 *
 * ## The vehicle filter (FIT-03, T204)
 *
 * Identical semantics to the glossary and the community directory, from the
 * same module: a row that does not fit the reader's truck **stays**, at 55%
 * opacity, carrying a "filtered" tag — the site offering its opinion rather
 * than enforcing it. A row whose match leaned on a facet the reader has not
 * answered carries the provisional mark (T203 review, F8), and on this page
 * the mark is drawn in the safety-critical chip token for rows that are
 * safety-critical, per T204's "especially prominent on safety surfaces".
 *
 * Nothing here interprets a fitment: `matchesVehicle` and
 * `provisionalMatchFacets` do, through `src/lib/vehicle-listing.ts` (FIT-01).
 *
 * refs specs/001-foundation (PRB-01, PRB-02, PRB-05, FIT-03, I18N-01, I18N-04,
 * I18N-08), specs/001-foundation/design/HANDOFF-DESIGN.md
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VehicleFitSummary from "../../components/VehicleFitSummary.astro";
import {
  LOCALE_BCP47,
  isLocale,
  localeHref,
  type Locale,
} from "../../i18n/routing";
import {
  COLLECTION_ROUTE_SEGMENTS,
  collectionRouteParams,
  collectionRoutePaths,
} from "../../i18n/routes";
import {
  drivabilityLabel,
  glossarySystemLabel,
  problemSeverityLabel,
  t,
} from "../../i18n/ui";
import { formatCount } from "../../lib/glossary-filter";
import { buildSymptomIndex } from "../../lib/problems-filter";
import { isSafetyCritical } from "../../lib/safety";
import { buildFitmentTable } from "../../lib/vehicle-listing";
import { compareProblems, problemRoutePath } from "../../lib/problems";

export function getStaticPaths() {
  return collectionRouteParams("problems", "problemsSegment");
}

const { locale: param } = Astro.params;
if (!isLocale(param)) {
  throw new Error(`Unknown locale segment: ${String(param)}`);
}
const locale: Locale = param;
const strings = t(locale);
const routes = collectionRoutePaths("problems");
const segment = COLLECTION_ROUTE_SEGMENTS.problems[locale];

const collator = new Intl.Collator(LOCALE_BCP47[locale], {
  sensitivity: "base",
});

const entries = await getCollection("problems");

const problems = entries
  .map((entry) => {
    const { data } = entry;
    const prose = data.prose[locale];
    return {
      id: entry.id,
      href: problemRoutePath(segment, prose.slug),
      title: prose.title,
      summary: prose.summary,
      system: data.system,
      severity: data.severity,
      drivability: data.drivability,
      safetyCritical: isSafetyCritical(data),
      /** Read by the vehicle filter; never interpreted here (FIT-01). */
      fitment: data.fitment,
      symptoms: data.symptoms.map((id) => prose.symptoms[id] ?? id),
    };
  })
  .sort((a, b) => compareProblems(a, b, collator));

const fitmentTable = buildFitmentTable(
  problems.map((problem) => problem.fitment)
);

/**
 * PRB-02's "picks" half — one pill per distinct symptom phrase across
 * `problems`, page locale, deduped and sorted by the reader's own collation.
 * See `buildSymptomIndex`'s docs for why this is a best-effort merge of
 * independently-authored text, not a canonical vocabulary.
 */
const symptomIndex = buildSymptomIndex(
  problems.map((problem) => ({ symptoms: problem.symptoms })),
  collator
);
---

<BaseLayout
  locale={locale}
  routePathByLocale={routes}
  title={`${strings.problemsHeading} — ${strings.siteTagline}`}
  description={strings.problemsIntro}
>
  <section class="problems" data-problems>
    <div class="problems__intro">
      <h1>{strings.problemsHeading}</h1>
      <p>{strings.problemsIntro}</p>
    </div>

    {
      problems.length === 0 ? (
        <p class="problems__empty">{strings.problemsEmpty}</p>
      ) : (
        <>
          <div class="problems__toolbar" data-problems-toolbar>
            <div class="problems__search">
              <label class="visually-hidden" for="problems-search">
                {strings.problemsSearchLabel}
              </label>
              <svg
                class="problems__search-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
                focusable="false"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="m21 21-4.3-4.3" />
              </svg>
              <input
                id="problems-search"
                type="search"
                autocomplete="off"
                data-problems-search
                placeholder={strings.problemsSearchPlaceholder}
              />
            </div>
            {symptomIndex.length > 0 && (
              <div
                class="problems__symptoms"
                role="group"
                aria-label={strings.problemsSymptomIndexLabel}
              >
                <button type="button" data-symptom="" aria-pressed="true">
                  {strings.problemsSymptomIndexAll}
                </button>
                {symptomIndex.map((entry) => (
                  <button
                    type="button"
                    data-symptom={entry.normalized}
                    aria-pressed="false"
                  >
                    {entry.label}
                  </button>
                ))}
              </div>
            )}
          </div>

          <p
            class="problems__count"
            data-problems-count
            data-count-template={strings.problemsCountTemplate}
            data-total={String(problems.length)}
            aria-live="polite"
          >
            {formatCount(
              strings.problemsCountTemplate,
              problems.length,
              problems.length
            )}
          </p>

          <VehicleFitSummary locale={locale} fitments={fitmentTable.table} />

          <ul class="problems__list">
            {problems.map((problem) => (
              <li
                class="problem-card"
                data-fitment={fitmentTable.indexOf(problem.fitment)}
                data-safety-critical={String(problem.safetyCritical)}
              >
                <p
                  class="problem-card__triage"
                  data-triage={problem.drivability}
                >
                  {drivabilityLabel(strings, problem.drivability)}
                </p>
                <h2 class="problem-card__title">
                  <a href={localeHref(locale, problem.href)}>{problem.title}</a>
                </h2>
                <p class="problem-card__summary">{problem.summary}</p>
                <p class="problem-card__chips">
                  <span class="chip chip--system">
                    {glossarySystemLabel(strings, problem.system)}
                  </span>
                  <span
                    class="chip chip--severity"
                    data-severity={problem.severity}
                  >
                    {problemSeverityLabel(strings, problem.severity)}
                  </span>
                  {/*
                   * One chip, not two (review F6): the safety chip is
                   * suppressed when the severity chip beside it already says
                   * the same word. It still appears on its own when the
                   * *system* is what makes the card safety-critical.
                   */}
                  {problem.safetyCritical &&
                    problem.severity !== "safety-critical" && (
                      <span class="chip chip--safety">
                        {problemSeverityLabel(strings, "safety-critical")}
                      </span>
                    )}
                </p>
                {problem.symptoms.length > 0 && (
                  <ul class="problem-card__symptoms">
                    {problem.symptoms.map((symptom) => (
                      <li>{symptom}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>

          <p class="problems__none" data-problems-none hidden>
            {strings.problemsNoResults}
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  import { formatCount } from "../../lib/glossary-filter";
  import {
    buildHaystack,
    matchesFilter,
    normalizedSymptoms,
    type ProblemFilterState,
  } from "../../lib/problems-filter";
  import { buildTaxonomy } from "../../lib/fitment";
  import { readSelectorPayload } from "../../lib/vehicle-taxonomy";
  import { createVehicleListingView } from "../../lib/vehicle-listing";
  import {
    onVehicleSelectionChange,
    readVehicleSelection,
    type StoredVehicleSelection,
  } from "../../lib/vehicle-selection";

  /**
   * Symptom-first navigation (T402, PRB-02) and the vehicle filter (T204,
   * FIT-03), layered on the same card list. Only DOM wiring lives here —
   * which elements to read, what to toggle. Every decision (does this card
   * match the picked symptom or the typed text? what does the counter say?
   * does this problem apply to the reader's truck?) is a pure function in
   * `src/lib/problems-filter.ts` or `src/lib/vehicle-listing.ts`.
   *
   * The per-card haystack is read from each card's own already-rendered
   * text — title, summary, symptom bullets, chip and triage labels — never
   * a second server-serialized copy (same discipline `[glossarySegment].astro`
   * documents for the same reason).
   */
  function enhance(root: HTMLElement): void {
    const cards = [...root.querySelectorAll<HTMLElement>(".problem-card")];
    if (cards.length === 0) return;

    const toolbar = root.querySelector<HTMLElement>("[data-problems-toolbar]");
    const search = root.querySelector<HTMLInputElement>(
      "[data-problems-search]"
    );
    const count = root.querySelector<HTMLElement>("[data-problems-count]");
    const none = root.querySelector<HTMLElement>("[data-problems-none]");

    const filterCards = cards.map((element) => {
      const symptomTexts = [
        ...element.querySelectorAll<HTMLElement>(".problem-card__symptoms li"),
      ].map((li) => li.textContent ?? "");

      return {
        element,
        filter: {
          symptoms: normalizedSymptoms(symptomTexts),
          haystack: buildHaystack({
            title:
              element.querySelector<HTMLElement>(".problem-card__title")
                ?.textContent ?? "",
            summary:
              element.querySelector<HTMLElement>(".problem-card__summary")
                ?.textContent ?? "",
            symptoms: symptomTexts,
            chips: [
              element.querySelector<HTMLElement>(".problem-card__triage")
                ?.textContent ?? "",
              ...[
                ...element.querySelectorAll<HTMLElement>(
                  ".problem-card__chips .chip"
                ),
              ].map((chip) => chip.textContent ?? ""),
            ],
          }),
        },
      };
    });

    const template = count?.dataset.countTemplate ?? "";
    const total = Number(count?.dataset.total ?? filterCards.length);
    const symptomButtons = toolbar
      ? [...toolbar.querySelectorAll<HTMLButtonElement>("[data-symptom]")]
      : [];

    let state: ProblemFilterState = { symptom: "", query: "" };

    /*
     * The vehicle filter (FIT-03: "any collection listing"). Same module and
     * therefore the same semantics as the glossary and community pages —
     * dim, tag, never hide — reading the taxonomy the selector already
     * inlined. `buildTaxonomy([])` keeps this harmless on a page with no
     * selector.
     */
    const vehicle = createVehicleListingView({
      root,
      cards,
      taxonomy: buildTaxonomy(readSelectorPayload(document)?.nodes ?? []),
      lang: document.documentElement.lang,
    });

    function applyVehicle(selection: StoredVehicleSelection | null): void {
      vehicle?.apply(selection);
    }

    function apply(): void {
      let shown = 0;

      for (const card of filterCards) {
        const visible = matchesFilter(card.filter, state);
        card.element.hidden = !visible;
        if (visible) shown += 1;
      }

      if (count) count.textContent = formatCount(template, shown, total);
      if (none) none.hidden = shown > 0;
      // The vehicle filter dims within whatever the symptom/search facets
      // left visible; re-marking after every apply keeps the two layers
      // consistent without either one interpreting the other's state.
      applyVehicle(readVehicleSelection(window));
    }

    if (search) {
      search.addEventListener("input", () => {
        state = { ...state, query: search.value };
        apply();
      });
    }

    for (const button of symptomButtons) {
      button.addEventListener("click", () => {
        const symptom = button.dataset.symptom ?? "";
        state = { ...state, symptom };
        for (const other of symptomButtons) {
          other.setAttribute(
            "aria-pressed",
            String((other.dataset.symptom ?? "") === symptom)
          );
        }
        apply();
      });
    }

    // The selector lives in the site chrome and knows nothing about this
    // page; it announces, and the listing re-marks itself (FIT-03).
    onVehicleSelectionChange(window, (selection) => applyVehicle(selection));
    apply();
  }

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-problems]"
  )) {
    enhance(root);
  }
</script>

<style is:global>
  /*
   * T204's "especially prominent on safety-critical surfaces". The provisional
   * marker is built in the browser by `src/lib/vehicle-listing.ts`, so it
   * cannot carry Astro's scoped-style attribute and its override has to be
   * global — scoped to this page's own card class, which nothing else uses.
   *
   * The upgrade is the safety-critical chip token (#7A2E2E on #F6E3D8, 7.48:1)
   * instead of the quiet confidence-chip one: on a row a reader might act on
   * with a wrench, "this matched partly because you did not say" is a warning,
   * not a footnote.
   */
  .problem-card[data-safety-critical="true"] .vehicle-fit__tag--provisional {
    color: #7a2e2e;
    background: #f6e3d8;
  }

  .problem-card[data-safety-critical="true"] .vehicle-fit {
    color: #55493c;
    font-weight: 500;
  }
</style>

<style>
  /*
   * Palette and card anatomy from HANDOFF-DESIGN.md, scoped to this page. As on
   * the detail template, `faint` (#A99C88) is never used for text — 2.69:1 on
   * a panel — and links on tinted backgrounds use `rust-deep`.
   */
  .problems {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 72rem;
  }

  .problems__intro h1 {
    margin: 0 0 0.5rem;
    font-size: 1.875rem;
    font-weight: 800;
    line-height: 1.15;
    color: #2b2620;
  }

  .problems__intro p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #55493c;
    max-width: 72ch;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /*
   * T402's search box and symptom pills, laid out only once `BaseLayout`
   * marks the document `html.js` — same reasoning `[glossarySegment].astro`
   * and `[communitySegment].astro` record at length: a visitor with no
   * JavaScript must see the full listing and no dead control, and asking
   * the question before first paint (rather than via a later `hidden`
   * toggle) avoids the layout shift a delayed reveal would cause.
   */
  .problems__toolbar {
    display: none;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(html.js) .problems__toolbar {
    display: flex;
  }

  .problems__search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    background: #fff;
    border: 1px solid #e4ddd1;
    border-radius: 8px;
    padding: 0.5rem 1rem;
    color: #6e6559;
  }

  .problems__search input {
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: 0.875rem;
    color: #2b2620;
    min-height: 1.75rem;
  }

  .problems__search input::placeholder {
    color: #6e6559;
    opacity: 1;
  }

  .problems__symptoms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .problems__symptoms button {
    font: inherit;
    font-size: 0.8125rem;
    border: 1px solid #e4ddd1;
    border-radius: 999px;
    padding: 0.5rem 1rem;
    min-height: 2.75rem;
    background: #fff;
    color: #55493c;
    cursor: pointer;
  }

  .problems__symptoms button[aria-pressed="true"] {
    background: #2b2620;
    border-color: #2b2620;
    color: #f7f4ee;
    font-weight: 700;
  }

  .problems__count {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #6e6559;
  }

  .problems__empty,
  .problems__none {
    margin: 0;
    font-size: 0.9375rem;
    color: #6e6559;
  }

  .problems__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    background: #fff;
    border: 1px solid #e4ddd1;
    border-radius: 8px;
    padding: 1.125rem 1.25rem;
  }

  /*
   * `display: flex` above beats the user-agent stylesheet's
   * `[hidden] { display: none }` (author rules win), so T402's search/symptom
   * filter — which hides a non-matching card by setting the `hidden`
   * property — needs this restated explicitly, same fix `[glossarySegment].astro`
   * and `[communitySegment].astro` record for their own cards. This is
   * unrelated to FIT-03's dim-and-tag below: the vehicle filter never hides.
   */
  .problem-card[hidden] {
    display: none;
  }

  /*
   * FIT-03's dim-and-tag: never hidden, and the opacity is never the only
   * signal — `src/lib/vehicle-listing.ts` adds the row of words that says the
   * same thing.
   */
  .problem-card[data-fits="false"] {
    opacity: 0.55;
    background: #fbf9f4;
  }

  .problem-card__triage {
    margin: 0;
    align-self: flex-start;
    border-radius: 4px;
    padding: 0.25rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #fff;
  }

  /* HANDOFF-DESIGN's validated triage table, as a compact card chip. */
  .problem-card__triage[data-triage="drive-normally"] {
    background: #3e7b4f;
  }

  .problem-card__triage[data-triage="drive-gently-repair-soon"] {
    background: #8a5e14;
  }

  .problem-card__triage[data-triage="do-not-drive"] {
    background: #a32c2c;
  }

  .problem-card__triage[data-triage="tow-only"] {
    background: #5a1f1f;
  }

  .problem-card__title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .problem-card__title a {
    color: #93441f;
    text-decoration: none;
  }

  .problem-card__title a:hover,
  .problem-card__title a:focus {
    text-decoration: underline;
  }

  .problem-card__summary {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: #55493c;
  }

  .problem-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    border-radius: 4px;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .chip--system,
  .chip--severity {
    color: #55493c;
    background: #efe9dd;
    border: 1px solid #e4ddd1;
  }

  .chip--severity[data-severity="safety-critical"],
  .chip--safety {
    font-weight: 700;
    color: #7a2e2e;
    background: #f6e3d8;
    border: 1px solid #e4c4b0;
  }

  .problem-card__symptoms {
    margin: 0;
    padding-left: 1.125rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #2b2620;
  }

  @media (max-width: 52rem) {
    .problems__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
