                <button
                  class="garage__link garage__link--danger"
                  type="button"
                  data-receipt-remove
                >
                  {strings.garageReceiptRemove}
                </button>
              </li>
            </template>

            {/*
             * What a record may point at (GAR-02′), inlined once per page.
             * `set:html` on a `<script type="application/json">` is JSON, not
             * markup: the browser never executes it, and `JSON.stringify`
             * escapes every value that goes in. The same seam
             * `VehicleSelector.astro` uses for the taxonomy payload.
             */}
            <script
              type="application/json"
              data-garage-references
              is:inline
              set:html={referenceCatalogueJson}
            />
          </div>
        </Fragment>
      ) : (
        <p class="garage__notice">{strings.garageUnavailable}</p>
      )
    }
  </section>
</BaseLayout>

<script>
