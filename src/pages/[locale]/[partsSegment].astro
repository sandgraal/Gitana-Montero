---
/**
 * The parts index (T501, PRT-01, PRT-02).
 *
 * > **PRT-01** THE `parts` collection SHALL hold, per entry: OEM part
 * > number(s) with supersession chain, fitment, aftermarket equivalents …
 *
 * ## One page, two URLs, one component (I18N-01)
 *
 * The seam T205 built for the glossary and T703a reused for the community
 * directory: the segment is translated (`/en/parts/` and `/es/repuestos/`), so
 * this file is parameterized on it and `getStaticPaths` reads both values from
 * `src/i18n/routes.ts`' registry. Neither locale is a redirect of the other.
 *
 * ## The card is a part number first
 *
 * The design handoff's rule — "if a value comes from shared `data`, it renders
 * in IBM Plex Mono" — is load-bearing here rather than decorative. A reader
 * scanning this page is looking for a **number**, and a number in the same
 * proportional face as the sentence around it is a number that is easy to
 * misread. So the OEM number is the largest monospace thing on the card, the
 * translated title sits above it as the human handle, and the supersession
 * badge (PRT-02's "which one do I order") is next to the number rather than
 * buried in the prose.
 *
 * ## Two filters, two shapes — T204's rule, restated
 *
 * The system pills **hide** what does not match: a reader who picks "brakes"
 * asked for a shorter list. The vehicle selector does not hide anything — a
 * part that does not fit the reader's truck stays on the page at 55% opacity
 * with a "filtered" tag, exactly as the Selector artboard draws it ("never
 * hidden silently"). A facet pill is the reader narrowing on purpose; a
 * fitment mismatch is the *site* deciding something is not for them, and on a
 * parts page in particular the site owes them the chance to disagree — a part
 * that "does not fit" is often the very number a reader is trying to rule out.
 *
 * Whether an entry fits is `matchesVehicle` and only `matchesVehicle`
 * (FIT-01), through `src/lib/vehicle-listing.ts`; whether the fit was
 * *provisional* is `provisionalMatchFacets`, rendered per row, because that is
 * the binding condition under which T203's permissive semantics were accepted.
 *
 * ## Empty today, and correct empty
 *
 * T503 authors the entries. Until then this page renders its heading, its
 * intro and `partsEmpty` — no toolbar, no dead controls — which is also the
 * state SCF-06 audits it in, since `collectionSampleTargets` picks a
 * collection's index page as its representative when the collection has no
 * entry pages yet.
 *
 * refs specs/001-foundation (PRT-01, PRT-02, I18N-01, I18N-04, I18N-08, FIT-03)
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  LOCALES,
  LOCALE_BCP47,
  isLocale,
  type Locale,
} from "../../i18n/routing";
import {
  collectionRouteParams,
  collectionRoutePaths,
  entryRoutePath,
} from "../../i18n/routes";
import VehicleFitSummary from "../../components/VehicleFitSummary.astro";
import {
  confidenceCaveat,
  generationLabel,
  glossarySystemLabel,
  t,
} from "../../i18n/ui";
import { formatCount } from "../../lib/glossary-filter";
import { needsConfidenceCaveat } from "../../lib/confidence";
import { isSafetyCritical } from "../../lib/safety";
import { buildTaxonomy, expandGenerations } from "../../lib/fitment";
import { buildFitmentTable } from "../../lib/vehicle-listing";
import { selectorTaxonomyData } from "../../lib/vehicle-taxonomy";
import { buildPartsIndex, readParts, supersessionChain } from "../../lib/parts";
import { GLOSSARY_SYSTEMS, type GlossarySystem } from "../../schemas/glossary";
import { GENERATION_IDS, type GenerationId } from "../../schemas/vehicles";

export function getStaticPaths() {
  return collectionRouteParams("parts", "partsSegment");
}

const { locale: param } = Astro.params;
if (!isLocale(param)) {
  throw new Error(`Unknown locale segment: ${String(param)}`);
}
const locale: Locale = param;
const strings = t(locale);
const routes = collectionRoutePaths("parts");

const otherLocale = LOCALES.find((candidate) => candidate !== locale) as Locale;
/** Page locale first — the handoff's rule for a bilingual-always block. */
const readingOrder: Locale[] = [locale, otherLocale];

const collator = new Intl.Collator(LOCALE_BCP47[locale], {
  sensitivity: "base",
});

/** A `GENERATION_IDS` value if `id` is one, else the raw string unchanged. */
function isKnownGeneration(id: string): id is GenerationId {
  return (GENERATION_IDS as readonly string[]).includes(id);
}

/**
 * The same taxonomy the selector ships to the browser, built here so the
 * *server* render answers generation questions the same way the client does —
 * one engine, one answer, whichever side of the wire asks (FIT-01).
 */
const taxonomy = buildTaxonomy(
  selectorTaxonomyData(
    (await getCollection("vehicles")).map((entry) => entry.data)
  ).nodes
);

const entries = await getCollection("parts");

/**
 * The supersession graph, built once for the whole page. The build has
 * already refused a dangling pointer or a loop
 * (`src/integrations/validate-parts.ts`), so `supersessionChain` returning
 * `null` here is unreachable in a build that got this far — the fallback is
 * "no chain", never a guess.
 */
const partsIndex = buildPartsIndex(readParts(entries.map((e) => e.data)));

const parts = entries
  .map((entry) => {
    const {
      id,
      oemNumber,
      system,
      quantityPerVehicle,
      confidence,
      fitment,
      prose,
    } = entry.data;
    const local = prose[locale];
    const chain = supersessionChain(id, partsIndex);
    const current = chain?.current ?? null;

    return {
      id,
      domId: `part-${id.replace(/\//g, "--")}`,
      href: entryRoutePath("parts", id, locale),
      oemNumber,
      system,
      systemLabel: glossarySystemLabel(strings, system),
      safetyCritical: isSafetyCritical(entry.data),
      quantityPerVehicle: quantityPerVehicle ?? null,
      /** PRT-02, on the card: is this the number to order, or a replaced one? */
      superseded: current !== null && current.id !== id,
      currentNumber: current === null || current.id === id ? null : current,
      fitment,
      genLabels: expandGenerations(fitment.gens, taxonomy).map((gen) =>
        isKnownGeneration(gen) ? generationLabel(strings, gen) : gen
      ),
      showCaveat: needsConfidenceCaveat(confidence),
      caveatByLocale: Object.fromEntries(
        readingOrder.map((each) => [
          each,
          confidenceCaveat(t(each), confidence),
        ])
      ) as Record<Locale, string>,
      title: local.title,
      summary: local.summary,
    };
  })
  .sort((a, b) => collator.compare(a.title, b.title));

/** Canonical taxonomy order, not alphabetical — the glossary page's rule. */
const systemOptions = (GLOSSARY_SYSTEMS as readonly GlossarySystem[])
  .filter((system) => parts.some((part) => part.system === system))
  .map((system) => ({
    code: system,
    label: glossarySystemLabel(strings, system),
  }));

/**
 * One entry per *distinct* fitment, so a listing whose rows mostly share one
 * does not repeat it in every card's attribute (T204 review, F3).
 */
const fitmentTable = buildFitmentTable(parts.map((part) => part.fitment));
---

<BaseLayout
  locale={locale}
  routePathByLocale={routes}
  title={`${strings.partsHeading} — ${strings.siteTagline}`}
  description={strings.partsIntro}
>
  <section class="parts" data-parts>
    <div class="parts__intro">
      <h1>{strings.partsHeading}</h1>
      <p>{strings.partsIntro}</p>
    </div>

    {
      parts.length === 0 ? (
        <p class="parts__empty">{strings.partsEmpty}</p>
      ) : (
        <>
          <div class="parts__toolbar" data-parts-toolbar>
            <div class="parts__filter-group">
              <span class="parts__filter-label">
                {strings.partsFilterSystemLabel}
              </span>
              <div
                class="parts__pills"
                role="group"
                aria-label={strings.partsFilterSystemLabel}
              >
                <button
                  type="button"
                  data-facet="system"
                  data-value=""
                  aria-pressed="true"
                >
                  {strings.partsFilterSystemAll}
                </button>
                {systemOptions.map((option) => (
                  <button
                    type="button"
                    data-facet="system"
                    data-value={option.code}
                    aria-pressed="false"
                  >
                    {option.label}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <p
            class="parts__count"
            data-parts-count
            data-count-template={strings.partsCountTemplate}
            data-total={String(parts.length)}
            aria-live="polite"
          >
            {formatCount(
              strings.partsCountTemplate,
              parts.length,
              parts.length
            )}
          </p>

          <VehicleFitSummary locale={locale} fitments={fitmentTable.table} />

          <ul class="parts__list" data-parts-list>
            {parts.map((part) => (
              <li
                class="part"
                id={part.domId}
                data-system={part.system}
                data-fitment={fitmentTable.indexOf(part.fitment)}
              >
                <div class="part__head">
                  <h2 class="part__title">
                    {part.href === null ? (
                      part.title
                    ) : (
                      <a href={part.href}>{part.title}</a>
                    )}
                  </h2>
                  <span class="part__system">{part.systemLabel}</span>
                </div>

                <p class="part__number">
                  <span class="part__number-label">
                    {strings.partsOemNumberLabel}
                  </span>
                  <span class="datum part__number-value">{part.oemNumber}</span>
                  <span
                    class:list={[
                      "part__badge",
                      part.superseded
                        ? "part__badge--superseded"
                        : "part__badge--current",
                    ]}
                  >
                    {part.superseded
                      ? strings.partsSupersededBadge
                      : strings.partsCurrentBadge}
                  </span>
                </p>

                {part.superseded && part.currentNumber !== null && (
                  <p class="part__replacement">
                    <span class="part__number-label">
                      {strings.partsSupersessionCurrentLabel}
                    </span>
                    <span class="datum">{part.currentNumber.oemNumber}</span>
                  </p>
                )}

                <p class="part__summary">{part.summary}</p>

                <div class="part__tags">
                  {part.safetyCritical && (
                    <span class="tag tag--safety">
                      {strings.safetyNoticeLabel}
                    </span>
                  )}
                  {part.quantityPerVehicle !== null && (
                    <span class="tag datum">
                      {strings.partsQuantityTemplate.replace(
                        "{count}",
                        new Intl.NumberFormat(LOCALE_BCP47[locale]).format(
                          part.quantityPerVehicle
                        )
                      )}
                    </span>
                  )}
                  {part.genLabels.map((label) => (
                    <span class="tag datum">{label}</span>
                  ))}
                </div>

                {part.showCaveat && (
                  <div class="part__caveat">
                    {readingOrder.map((each, index) => (
                      <p
                        class:list={[
                          "caveat__line",
                          index === 0 && "caveat__line--primary",
                        ]}
                        lang={LOCALE_BCP47[each]}
                      >
                        {part.caveatByLocale[each]}
                      </p>
                    ))}
                  </div>
                )}
              </li>
            ))}
          </ul>

          <p class="parts__none" data-parts-none hidden>
            {strings.partsNoResults}
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<script>
  import {
    EMPTY_PARTS_FILTER,
    matchesPartsFilter,
    type PartsFilterState,
  } from "../../lib/parts/filter";
  import { formatCount } from "../../lib/glossary-filter";
  import { buildTaxonomy } from "../../lib/fitment";
  import { readSelectorPayload } from "../../lib/vehicle-taxonomy";
  import { createVehicleListingView } from "../../lib/vehicle-listing";
  import {
    onVehicleSelectionChange,
    readVehicleSelection,
    type StoredVehicleSelection,
  } from "../../lib/vehicle-selection";

  /**
   * Client-side filtering and the vehicle fit view. Enhancement only — the
   * toolbar is laid out only when the document is marked script-capable (see
   * the CSS note below), so a visitor with no JavaScript sees every part and
   * no dead control. DOM wiring only: `matchesPartsFilter`
   * (`src/lib/parts/filter.ts`) owns the pill rule,
   * `src/lib/vehicle-listing.ts` owns the vehicle filter, and
   * `src/lib/fitment/` owns every fitment answer (FIT-01).
   */
  function enhance(root: HTMLElement): void {
    const toolbar = root.querySelector<HTMLElement>("[data-parts-toolbar]");
    const count = root.querySelector<HTMLElement>("[data-parts-count]");
    const none = root.querySelector<HTMLElement>("[data-parts-none]");
    const cards = [...root.querySelectorAll<HTMLElement>(".part")];
    if (!toolbar || !count || !none) return;

    const template = count.dataset.countTemplate ?? "";
    const total = Number(count.dataset.total ?? cards.length);
    const state: PartsFilterState = { ...EMPTY_PARTS_FILTER };

    const payload = readSelectorPayload(document);
    // The same nodes the selector shipped, read once. Without a selector on
    // the page there is no taxonomy and no vehicle filter — the pills still
    // work, and `buildTaxonomy([])` gives the generation facet its
    // "no expansion" reading rather than throwing.
    const taxonomy = buildTaxonomy(payload?.nodes ?? []);

    const vehicle = createVehicleListingView({
      root,
      cards,
      taxonomy,
      lang: document.documentElement.lang,
    });

    function apply(): void {
      let shown = 0;
      for (const card of cards) {
        const visible = matchesPartsFilter(
          { system: card.dataset.system ?? "" },
          state
        );
        card.hidden = !visible;
        if (visible) shown += 1;
      }
      count!.textContent = formatCount(template, shown, total);
      none!.hidden = shown > 0;
      applyVehicle(readVehicleSelection(window));
    }

    function applyVehicle(selection: StoredVehicleSelection | null): void {
      vehicle?.apply(selection);
    }

    const buttons = [
      ...toolbar.querySelectorAll<HTMLButtonElement>('[data-facet="system"]'),
    ];
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const value = button.dataset.value ?? "";
        state.system = value;
        for (const sibling of buttons) {
          sibling.setAttribute(
            "aria-pressed",
            String((sibling.dataset.value ?? "") === value)
          );
        }
        apply();
      });
    }

    // The selector lives in the site chrome and knows nothing about this
    // page; it announces, and the listing re-filters (FIT-03).
    onVehicleSelectionChange(window, (selection) => applyVehicle(selection));

    apply();
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-parts]")) {
    enhance(root);
  }
</script>

<style>
  /*
   * Tokens from specs/001-foundation/design/HANDOFF-DESIGN.md, scoped to this
   * page — site-wide chrome tokens belong to the task that restyles the
   * chrome, not to a collection page (the glossary and community pages'
   * identical note).
   */
  .parts {
    --paper: #f7f4ee;
    --panel: #ffffff;
    --panel-soft: #fbf9f4;
    --ink: #2b2620;
    --muted: #6e6559;
    --muted-strong: #55493c;
    --faint: #a99c88;
    --line: #e4ddd1;
    --chip: #efe9dd;
    --rust: #b0532a;
    --rust-deep: #93441f;
    --green: #3e6b4f;
    --green-tint: #e4efe7;
    --caveat-bg: #efeae0;
    --caveat-border: #a99c88;
    --caveat-text: #55493c;
    --safety-text: #7a2e2e;
    --safety-bg: #f6e3d8;
    --safety-border: #e4c4b0;

    font-family: Archivo, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 75rem;
  }

  .parts__intro {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .parts__intro h1 {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .parts__intro p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 62ch;
  }

  /*
   * Laid out only when scripting is available — the pattern T204 settled on
   * the community page: `[hidden]` loses to an author `display: flex`, and
   * revealing the toolbar after the module script loads pushed every card
   * down (CLS past SCF-06's budget). `BaseLayout` marks the document `js`
   * before first paint, so CSS can answer the question with no shift and no
   * dead control.
   */
  .parts__toolbar {
    display: none;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(html.js) .parts__toolbar {
    display: flex;
  }

  .parts__filter-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
  }

  .parts__filter-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
    flex: 0 0 auto;
    min-width: 8rem;
  }

  .parts__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .parts__pills button {
    font: inherit;
    font-size: 0.8125rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    min-height: 2.75rem;
    background: var(--panel);
    color: var(--muted-strong);
    cursor: pointer;
  }

  .parts__pills button[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
    font-weight: 700;
  }

  .parts__count,
  .parts__none,
  .parts__empty {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .parts__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .part {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.25rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .part[hidden] {
    display: none;
  }

  /* The Selector artboard's third state — dimmed, tagged, never removed. */
  .part[data-fits="false"] {
    background: var(--panel-soft);
    opacity: 0.55;
  }

  .part__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .part__title {
    margin: 0;
    font-size: 1.1875rem;
    font-weight: 700;
  }

  .part__title a {
    color: var(--rust-deep);
    text-decoration: none;
  }

  .part__title a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .part__system {
    flex: 0 0 auto;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted-strong);
    background: var(--chip);
    border-radius: 4px;
    padding: 0.1875rem 0.5rem;
  }

  /*
   * The handoff's rule, applied where it matters most: every value that came
   * out of shared `data` renders in IBM Plex Mono. A part number in a
   * proportional face is a part number somebody mistypes at the counter.
   */
  .datum {
    font-family:
      "IBM Plex Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  .part__number,
  .part__replacement {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .part__number-label {
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--muted);
  }

  .part__number-value {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .part__badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 4px;
    padding: 0.1875rem 0.5rem;
  }

  .part__badge--current {
    color: var(--green);
    background: var(--green-tint);
  }

  .part__badge--superseded {
    color: var(--muted-strong);
    background: var(--chip);
  }

  .part__summary {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted-strong);
  }

  .part__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    font-size: 0.75rem;
    background: var(--chip);
    border-radius: 4px;
    padding: 0.125rem 0.5rem;
    color: var(--muted-strong);
  }

  .tag--safety {
    font-family: Archivo, "Helvetica Neue", Arial, sans-serif;
    font-weight: 700;
    color: var(--safety-text);
    background: var(--safety-bg);
    border: 1px solid var(--safety-border);
  }

  /* Confidence caveat — the handoff's dashed caveat panel token. */
  .part__caveat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: var(--caveat-bg);
    border: 1.5px dashed var(--caveat-border);
    border-radius: 8px;
    padding: 0.625rem 0.875rem;
  }

  .caveat__line {
    margin: 0;
    color: var(--caveat-text);
    font-size: 0.8125rem;
  }

  .caveat__line--primary {
    font-weight: 600;
  }

  .caveat__line:not(.caveat__line--primary) {
    font-size: 0.75rem;
    opacity: 0.85;
  }

  @media (max-width: 48rem) {
    .parts__list {
      grid-template-columns: 1fr;
    }

    .parts__intro h1 {
      font-size: 1.5rem;
    }

    .parts__filter-label {
      min-width: 0;
    }
  }
</style>
