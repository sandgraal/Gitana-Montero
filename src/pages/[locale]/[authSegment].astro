---
/**
 * The sign-in / account page (T2-202, ACC-01, ACC-02).
 *
 * > **ACC-01** THE site SHALL authenticate users via Supabase Auth with email
 * > magic link and Google OAuth, and no password flow.
 * > **ACC-02** THE account surface SHALL be fully bilingual.
 *
 * ## One page, two URLs, one component (I18N-01)
 *
 * `/en/sign-in/` and `/es/ingresar/` are built from this file by the same
 * `getStaticPaths` seam the glossary and community pages use; the segments
 * live in `src/i18n/routes.ts` so hreflang, the canonical link and the locale
 * switcher all name the URL that was actually built for each locale.
 *
 * ## What is on the page, and what is deliberately not
 *
 * Two ways in and nothing else. There is no password field, no "forgot your
 * password" link and no registration step, because a first magic link *is* the
 * registration. That absence is stated in the copy rather than left as a hole
 * the reader has to interpret: a form with no password box reads as broken
 * unless it says why.
 *
 * Deletion (ACC-03) has its routines in the database and no button here yet —
 * it belongs with the account settings T2-301 opens, not on a page whose whole
 * job is getting in.
 *
 * ## No project? Then say so
 *
 * Provisioning the Supabase project is an owner action, so every build until
 * then has no `PUBLIC_SUPABASE_URL`. The page renders an honest notice in that
 * state instead of a form that cannot work — and the enhancement script never
 * fetches the Supabase chunk at all, so the a11y and performance budgets are
 * measured on the page a reader actually gets.
 *
 * refs specs/002-montero-garage (ACC-01, ACC-02, ACC-04, SHR-01)
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isLocale, type Locale } from "../../i18n/routing";
import { collectionRouteParams, collectionRoutePaths } from "../../i18n/routes";
import { t } from "../../i18n/ui";
import { SITE_NAME } from "../../site";
import { SUPABASE_BROWSER_CONFIG } from "../../lib/supabase/config";

export function getStaticPaths() {
  return collectionRouteParams("signIn", "authSegment");
}

const { locale: param } = Astro.params;
if (!isLocale(param)) {
  throw new Error(`Unknown locale segment: ${String(param)}`);
}
const locale: Locale = param;
const strings = t(locale);
const routes = collectionRoutePaths("signIn");
const configured = SUPABASE_BROWSER_CONFIG !== null;
---

<BaseLayout
  locale={locale}
  routePathByLocale={routes}
  title={`${strings.signInHeading} — ${SITE_NAME}`}
  description={strings.signInIntro}
>
  <section
    class="signin"
    data-signin
    data-string-sent={strings.signInLinkSentTemplate}
    data-string-invalid={strings.signInEmailInvalid}
    data-string-error={strings.signInError}
    data-string-busy={strings.signInEmailSubmitBusy}
    data-string-signed-in={strings.signInSignedInTemplate}
  >
    <div class="signin__intro">
      <h1>{strings.signInHeading}</h1>
      <p>{strings.signInIntro}</p>
    </div>

    {
      configured ? (
        <div class="signin__panel">
          <p class="signin__status" data-signin-signed-in hidden>
            <span data-signin-account />
            <button class="signin__link" type="button" data-signin-signout>
              {strings.signInSignOut}
            </button>
          </p>

          <div data-signin-forms>
            <form class="signin__form" data-signin-form novalidate>
              <label class="signin__label" for="signin-email">
                {strings.signInEmailLabel}
              </label>
              <input
                class="signin__input"
                id="signin-email"
                name="email"
                type="email"
                autocomplete="email"
                spellcheck="false"
                required
                placeholder={strings.signInEmailPlaceholder}
              />
              <button class="signin__button" type="submit" data-signin-submit>
                {strings.signInEmailSubmit}
              </button>
            </form>

            <p class="signin__divider">{strings.signInAlternativeLabel}</p>

            <button
              class="signin__button signin__button--alt"
              type="button"
              data-signin-google
            >
              {strings.signInGoogleLabel}
            </button>
          </div>

          <p
            class="signin__message"
            data-signin-message
            role="status"
            aria-live="polite"
          />

          <noscript>
            <p class="signin__notice">{strings.signInScriptRequired}</p>
          </noscript>
        </div>
      ) : (
        <p class="signin__notice">{strings.signInUnavailable}</p>
      )
    }

    <p class="signin__fineprint">{strings.signInNoPasswordNote}</p>
    <p class="signin__fineprint">{strings.signInPrivacyNote}</p>
  </section>
</BaseLayout>

<script>
  import {
    currentEmail,
    looksLikeEmail,
    sendMagicLink,
    signOut,
    startGoogleSignIn,
  } from "../../lib/supabase/auth";
  import { SUPABASE_BROWSER_CONFIG } from "../../lib/supabase/config";

  /**
   * DOM wiring only. Every decision worth testing lives in
   * `src/lib/supabase/auth.ts`, and every string comes from the markup the
   * server already localized (I18N-08) — this script never composes prose.
   */
  function enhance(root: HTMLElement): void {
    const form = root.querySelector<HTMLFormElement>("[data-signin-form]");
    const input = root.querySelector<HTMLInputElement>("#signin-email");
    const submit = root.querySelector<HTMLButtonElement>(
      "[data-signin-submit]"
    );
    const google = root.querySelector<HTMLButtonElement>(
      "[data-signin-google]"
    );
    const message = root.querySelector<HTMLElement>("[data-signin-message]");
    const forms = root.querySelector<HTMLElement>("[data-signin-forms]");
    const signedIn = root.querySelector<HTMLElement>("[data-signin-signed-in]");
    const account = root.querySelector<HTMLElement>("[data-signin-account]");
    const out = root.querySelector<HTMLButtonElement>("[data-signin-signout]");
    if (!form || !input || !submit || !google || !message) return;

    // Re-bound after the guard so the live region is a non-null `HTMLElement`
    // inside the handlers below, without a non-null assertion.
    const status: HTMLElement = message;

    const strings = {
      sent: root.dataset.stringSent ?? "",
      invalid: root.dataset.stringInvalid ?? "",
      error: root.dataset.stringError ?? "",
      busy: root.dataset.stringBusy ?? "",
      idle: submit.textContent ?? "",
      signedIn: root.dataset.stringSignedIn ?? "",
    };

    function say(text: string): void {
      status.textContent = text;
    }

    function showSession(email: string | null): void {
      if (!signedIn || !account || !forms) return;
      signedIn.hidden = email === null;
      forms.hidden = email !== null;
      account.textContent =
        email === null ? "" : strings.signedIn.replace("{email}", email);
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const email = input.value.trim();
      if (!looksLikeEmail(email)) {
        say(strings.invalid);
        input.focus();
        return;
      }
      submit.disabled = true;
      submit.textContent = strings.busy;
      say("");
      void sendMagicLink(email, window.location.href)
        .then((outcome) => {
          say(
            outcome.ok ? strings.sent.replace("{email}", email) : strings.error
          );
        })
        .finally(() => {
          submit.disabled = false;
          submit.textContent = strings.idle;
        });
    });

    google.addEventListener("click", () => {
      google.disabled = true;
      say("");
      void startGoogleSignIn(window.location.href)
        .then((outcome) => {
          if (!outcome.ok) say(strings.error);
        })
        .finally(() => {
          google.disabled = false;
        });
    });

    out?.addEventListener("click", () => {
      void signOut().then(() => showSession(null));
    });

    void currentEmail().then(showSession);
  }

  const root = document.querySelector<HTMLElement>("[data-signin]");
  // No project configured means no client, no chunk fetched, and nothing on
  // this page to wire up — the notice the server rendered is the whole page.
  if (root && SUPABASE_BROWSER_CONFIG) enhance(root);
</script>

<style>
  /*
   * Tokens from specs/001-foundation/design/HANDOFF-DESIGN.md, scoped to this
   * page — same note as the glossary and community pages: site-wide chrome
   * tokens belong to the task that restyles the chrome.
   */
  .signin {
    --paper: #f7f4ee;
    --panel: #ffffff;
    --ink: #2b2620;
    --muted: #6e6559;
    --muted-strong: #55493c;
    --line: #e4ddd1;
    --rust: #b0532a;
    --rust-deep: #93441f;
    --rust-tint: #fbeee6;
    --rust-tint-border: #e9cdbb;

    font-family: Archivo, "Helvetica Neue", Arial, sans-serif;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 34rem;
  }

  /*
   * F10 (T2-303 review sweep of the same trap across the site): an
   * author-origin `display: flex` beats the user-agent `[hidden] { display:
   * none }` rule. `.signin__status` (below) hit it for real — the "You're
   * signed in as ___" line rendered, empty and inert, for a signed-out
   * visitor, because it ships `hidden` in the server markup but its own
   * `display: flex` outranked the user-agent rule. Rather than patch that one
   * selector, this closes the whole class the same way `[garageSegment].astro`
   * does: no descendant of `.signin` — present or future — can ever compute a
   * display other than `none` while it carries `hidden`. `!important` is
   * deliberate, for the same reason as the garage page's identical rule:
   * matching selector specificity against an unknown, growing set of
   * `display: flex`/`grid` declarations is the trap, not a defense against
   * it. Graded by `tests/e2e/hidden-guard.spec.ts`.
   */
  .signin [hidden] {
    display: none !important;
  }

  .signin__intro {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .signin__intro h1 {
    margin: 0;
    font-size: 1.875rem;
    font-weight: 800;
    letter-spacing: -0.3px;
  }

  .signin__intro p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted-strong);
  }

  .signin__panel {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .signin__form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .signin__label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .signin__input {
    font: inherit;
    font-size: 1rem;
    padding: 0.625rem 0.75rem;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 6px;
    min-height: 44px;
  }

  .signin__input:focus-visible {
    outline: 2px solid var(--rust);
    outline-offset: 1px;
  }

  .signin__button {
    font: inherit;
    font-weight: 600;
    min-height: 44px;
    padding: 0.625rem 1rem;
    color: #ffffff;
    background: var(--rust);
    border: 1px solid var(--rust);
    border-radius: 6px;
    cursor: pointer;
  }

  .signin__button:hover {
    background: var(--rust-deep);
    border-color: var(--rust-deep);
  }

  .signin__button:disabled {
    cursor: progress;
    opacity: 0.75;
  }

  .signin__button--alt {
    width: 100%;
    color: var(--rust-deep);
    background: var(--rust-tint);
    border-color: var(--rust-tint-border);
  }

  .signin__button--alt:hover {
    color: #ffffff;
  }

  .signin__divider {
    margin: 0;
    text-align: center;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--muted);
  }

  .signin__status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted-strong);
  }

  .signin__link {
    font: inherit;
    padding: 0;
    color: var(--rust);
    background: none;
    border: none;
    text-decoration: underline;
    cursor: pointer;
  }

  .signin__link:hover {
    color: var(--rust-deep);
  }

  /*
   * Kept in the layout at all times, empty or not: a live region that is
   * `display: none` when empty is not in the accessibility tree, so the first
   * message it ever receives is the one nobody hears.
   */
  .signin__message {
    min-height: 0;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted-strong);
  }

  .signin__notice {
    margin: 0;
    padding: 0.875rem 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted-strong);
    background: var(--rust-tint);
    border: 1px solid var(--rust-tint-border);
    border-radius: 8px;
  }

  .signin__fineprint {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 40rem) {
    .signin__intro h1 {
      font-size: 1.5rem;
    }
  }
</style>
